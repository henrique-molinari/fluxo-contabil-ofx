# Copie este arquivo para env/.env e preencha. O env/.env NÃO vai para o Git.

# --- Servidor ---
PORT=3333
NODE_ENV=development
# Endereço do frontend liberado no CORS (separe vários por vírgula)
CORS_ORIGENS=http://localhost:5173

# --- Banco de dados (PostgreSQL) ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=ofx
PGUSER=postgres
PGPASSWORD=sua_senha
# Neon e outros serviços na nuvem exigem "require"
PGSSLMODE=prefer

# --- Autenticação (JWT) ---
# Gere um segredo longo e aleatório:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SEGREDO=troque-este-segredo-por-um-valor-grande-e-aleatorio
JWT_EXPIRA_EM=15m
REFRESH_EXPIRA_DIAS=7

# --- Usuários de exemplo (npm run db:seed) ---
SEED_SENHA=Mudar@123
